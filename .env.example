# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Anon/public key (NOT the service key) — used only to mint anonymous
# sessions for bot conversations, see src/conversation/anonymousAuth.ts
SUPABASE_ANON_KEY=your-anon-key

# Conversation bot (Telegram — build/test channel, no verification required)
# Get one from @BotFather on Telegram: message it, /newbot, copy the token.
TELEGRAM_BOT_TOKEN=
# Base URL the conversation engine calls back into itself on
# (POST /spaces, /uploads/*) — defaults to http://localhost:$PORT, only set
# this if the bot process is separate from the main API process.
INTERNAL_API_BASE_URL=

# Conversation bot (WhatsApp Cloud API — real production channel)
# From Meta App Dashboard > WhatsApp > API Setup, or a permanent System
# User token (Business Settings > Users > System Users) for production.
WHATSAPP_ACCESS_TOKEN=
# Same API Setup page — the number's Phone Number ID (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Any random string YOU choose — set the same value in the App Dashboard's
# WhatsApp > Configuration > Webhook screen. Generate one with e.g.
# `openssl rand -hex 32`.
WHATSAPP_VERIFY_TOKEN=
# App Dashboard > Settings > Basic > App Secret (click "Show"). Used to
# verify incoming webhook calls really came from Meta. Optional but strongly
# recommended — the webhook logs a warning and skips verification if unset.
WHATSAPP_APP_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_BUCKET_NAME=viewora-tours
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
MEDIA_DOMAIN=https://media.viewora.software

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your-key

# Redis (BullMQ job queue + auth/billing cache)
REDIS_URL=redis://default:password@localhost:6379

# App
PORT=3001
NODE_ENV=production
# URL of the dashboard app — used for Paystack payment callback redirect
APP_URL=https://app.viewora.software
CORS_ORIGIN=https://viewora.software,https://app.viewora.software,https://viewora.vercel.app

# Security
# Random secret shared between the API server and the tile worker
WORKER_SECRET=generate-a-random-secret-here
# Key required to call the /maintenance/sync-limits endpoint
MAINTENANCE_KEY=generate-a-random-key-here
# Token required to scrape the /metrics endpoint (leave unset to disable auth)
METRICS_TOKEN=

# Email (Resend)
RESEND_API_KEY=re_your-api-key

# Gemini (all AI features: auto-link tour editing + listing descriptions). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash. Pick a model your free-tier quota covers.
GEMINI_MODEL=
# Optional — photo edits (remove/add objects). NO free tier: needs billing on the key (~US$0.03–0.07/edit).
# Defaults to gemini-3.1-flash-lite-image (cheapest); gemini-nano-banana-2.1 is higher quality.
GEMINI_IMAGE_MODEL=

# Sentry (optional — leave blank to disable error tracking)
SENTRY_DSN=

# PostHog (optional — leave blank to disable server-side analytics)
# Use your PostHog project API key. If self-hosted, set POSTHOG_HOST to your instance URL.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# PostHog (optional — leave blank to disable server-side analytics)
POSTHOG_API_KEY=
