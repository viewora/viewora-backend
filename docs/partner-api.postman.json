{
  "info": {
    "name": "Viewora Partner API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.viewora.software/v1"
    },
    {
      "key": "apiKey",
      "value": "vo_test_your_sandbox_key"
    }
  ],
  "item": [
    {
      "name": "Create an agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/agents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "agents"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Creates a Viewora account for the agent. Calling it again with the same external_id returns the existing agent (200, created: false). email is required for live agents and becomes their login; no email is sent. Test agents ignore email.\n\nScope: `agents:write`"
      }
    },
    {
      "name": "List your agents",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/agents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "agents"
          ]
        },
        "description": "Scope: `agents:write`"
      }
    },
    {
      "name": "Read one agent",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/agents/:external_id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "agents",
            ":external_id"
          ]
        },
        "description": "Scope: `agents:write`"
      }
    },
    {
      "name": "Create a tour",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "type is one of residential, commercial, hospitality, education, automotive, land, other. details may hold: price_kes, listing_status, transaction_type, price_period, bedrooms, bathrooms, area_sqm, vehicle_year, vehicle_mileage_km, vehicle_transmission, vehicle_fuel_type, land_acres, land_type, amenities. A repeated external_id answers 409 TOUR_EXISTS with the existing tour in error.tour.\n\nScope: `listings:write`"
      }
    },
    {
      "name": "List or find tours",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    },
    {
      "name": "Read one tour",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours",
            ":id"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    },
    {
      "name": "Delete a tour",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours",
            ":id"
          ]
        },
        "description": "Permanent. The tour, its scenes and its page are removed.\n\nScope: `listings:write`"
      }
    },
    {
      "name": "Publish a tour",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours/:id/publish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours",
            ":id",
            "publish"
          ]
        },
        "description": "After this the tour has embed_url and share_url.\n\nScope: `listings:write`"
      }
    },
    {
      "name": "Take a tour down",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours/:id/unpublish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours",
            ":id",
            "unpublish"
          ]
        },
        "description": "Scope: `listings:write`"
      }
    },
    {
      "name": "Start an upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours/:id/uploads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours",
            ":id",
            "uploads"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Step 1 of 3. Returns a signed URL valid for 15 minutes. Step 2: PUT the file to upload_url with the headers given. Step 3: POST /tours/{id}/uploads/complete. kind: panorama (a 2:1 360° JPEG, becomes a scene), photo (goes to the gallery) or car_exterior (one angle of a car spin).\n\nScope: `media:write`"
      }
    },
    {
      "name": "Finish an upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tours/:id/uploads/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tours",
            ":id",
            "uploads",
            "complete"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Step 3 of 3. Processing starts and takes a short while. Calling this twice for the same file is safe. car_exterior needs angle (0 = front).\n\nScope: `media:write`"
      }
    },
    {
      "name": "Create a listing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Synchronous. Media sent by source_url are fetched in the background; the listing goes live when they are ready.\n\nScope: `listings:write`"
      }
    },
    {
      "name": "List your listings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    },
    {
      "name": "Read one listing",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings",
            ":id"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    },
    {
      "name": "Update partner-owned fields",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings",
            ":id"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Send only what changed. Sending media replaces the media list. If-Match: <version> is recommended. An update whose partner_updated_at is older than the stored one is ignored (applied: false, reason: stale). On a live listing, a price drop over 30%, a currency change or a 3rd change in 24 hours is held for review (202).\n\nScope: `listings:write`"
      }
    },
    {
      "name": "Withdraw and archive (restorable for 30 days)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings",
            ":id"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Scope: `listings:write`"
      }
    },
    {
      "name": "Undo an archive",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings/:id/restore",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings",
            ":id",
            "restore"
          ]
        },
        "description": "Scope: `listings:write`"
      }
    },
    {
      "name": "Upsert up to 500 listings (asynchronous)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings/bulk",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings",
            "bulk"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "An item whose external_id exists is a partial update; otherwise it is created. dry_run checks every item without writing.\n\nScope: `listings:write`"
      }
    },
    {
      "name": "Import progress and per-row errors",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/imports/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "imports",
            ":id"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    },
    {
      "name": "Compare your active listings with Viewora's",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/listings/reconcile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listings",
            "reconcile"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Changes nothing. Lists listings Viewora holds that you did not send, ids Viewora does not know, and versions you are behind on.\n\nScope: `listings:read`"
      }
    },
    {
      "name": "Add one file by URL to a listing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/media",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "media"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "The file is fetched in the background (https only, public addresses, 25 MB photos, 60 MB panoramas). Files on your computer: use POST /tours/{tour_id}/uploads.\n\nScope: `media:write`"
      }
    },
    {
      "name": "Register an endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Scope: `webhooks:manage`"
      }
    },
    {
      "name": "List endpoints",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks"
          ]
        },
        "description": "Scope: `webhooks:manage`"
      }
    },
    {
      "name": "Delete an endpoint",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks",
            ":id"
          ]
        },
        "description": "Scope: `webhooks:manage`"
      }
    },
    {
      "name": "Send a webhook.test event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks/:id/test",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks",
            ":id",
            "test"
          ]
        },
        "description": "Scope: `webhooks:manage`"
      }
    },
    {
      "name": "Switch a disabled endpoint back on",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks/:id/enable",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks",
            ":id",
            "enable"
          ]
        },
        "description": "Scope: `webhooks:manage`"
      }
    },
    {
      "name": "New signing secret; the old one keeps signing for 24 hours",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks/:id/rotate-secret",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks",
            ":id",
            "rotate-secret"
          ]
        },
        "description": "Scope: `webhooks:manage`"
      }
    },
    {
      "name": "Ask an agent to let you manage a tour they made in the Viewora app",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/claims",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "claims"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "The agent approves or declines in the app (claim.approved / claim.declined events; claims expire after 14 days). After approval, POST /v1/listings with the same external_id puts your listing on that tour.\n\nScope: `listings:write`"
      }
    },
    {
      "name": "Your claims",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/claims",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "claims"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    },
    {
      "name": "One claim",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/claims/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "claims",
            ":id"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    },
    {
      "name": "Withdraw a claim that is still waiting",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/claims/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "claims",
            ":id"
          ]
        },
        "description": "Scope: `listings:write`"
      }
    },
    {
      "name": "Last 50 deliveries",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/webhooks/:id/deliveries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webhooks",
            ":id",
            "deliveries"
          ]
        },
        "description": "Scope: `webhooks:manage`"
      }
    },
    {
      "name": "Leads for your listings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/leads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leads"
          ]
        },
        "description": "Granted only after the data-processing addendum is signed. Only buyers who agreed to share their details with you are listed, each with the exact consent wording. Every read is logged.\n\nScope: `leads:read`"
      }
    },
    {
      "name": "Views per listing per day (at most 92 days)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/analytics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analytics"
          ]
        },
        "description": "Scope: `analytics:read`"
      }
    },
    {
      "name": "Read-only feed of your agents' published tours, including ones made in the Viewora app",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/export/listings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "export",
            "listings"
          ]
        },
        "description": "Scope: `listings:read`"
      }
    }
  ]
}
